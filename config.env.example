# wechat-loop 凭证配置 — 复制为 config.env 后填写（config.env 已在 .gitignore 中）
# 所有键都可以用同名环境变量覆盖，环境变量优先。

# ── 自己公众号（入草稿轨 A + 自己号采集）──────────────────
# 公众号后台 → 设置与开发 → 基本配置
WECHAT_APPID=
WECHAT_APPSECRET=

# ── 竞品号采集（走 mp.weixin.qq.com 后台翻页）────────────
# 扫码登录后从浏览器 Cookie 里取，配合 token 使用
WECHAT_TOKEN=
WECHAT_COOKIE=

# ── 日期关键词自动回复（set_keyword.py）──────────────────
# 回复正文，支持 \n 换行
WECHAT_KEYWORD_REPLY=

# ── 可选：上游仓库不在仓库内/同级时，用它指定父目录 ────────
# WECHAT_LOOP_UPSTREAM_DIR=/Users/you/code
