# ── 本地工具链（venv + chromium，由 bootstrap.sh 生成） ──
.toolchain/
tools/gate/activate.sh
tools/gate/.bootstrap_stamp

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# ── 运行时产物（放行，新账户接手需要） ──
# loop/runs/       ✅ 放行 — run_daily 每次的产物
# loop/history.json ✅ 放行 — 去重用
# loop/knowledge_base.json ✅ 放行 — demo KB 初始数据
# loop/kb/*/       ✅ 放行 — 采集样本
# ── 但 cookies/token 类 json 绝对不能进 ──
loop/*cookies*
loop/*storage*
loop/*token*
# 备份文件不推
loop/knowledge_base.json.bak

# ── 其他 json（cookies/storage_state 等，绝对不能推） ──
# 默认排除所有 json
*.json
# 放行：运行时 KB/history
!loop/history.json
!loop/knowledge_base.json
# 放行：run_daily 每次产物（evidence_pack / topic_candidates）
!loop/runs/**/*.json
# 放行：scripts 目录下配置 json
!scripts/*.json
!scripts/*.json.example

# ── env / token ──
config.env
.env
*.token

# ── 浏览器 profile ──
.chrome-profile/
.chrome-ide-profile/
browser_pid.txt

# ── 临时文件 ──
login-qrcode*.png
login-page.png
ctx_meta.json
*.tmp

# ── 上游依赖（各自独立 git 仓库，不嵌套提交，打包当 release asset） ──
/wechat-flow/
/wechat-flow-film/
/wechat-digest-skill/

# ── IDE ──
.vscode/
.idea/
# 工作区 .trae 可能有 personal skill
.trae/
.trae/skills/

# ── 系统 ──
.DS_Store
Thumbs.db
